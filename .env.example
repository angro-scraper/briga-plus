# Produkciona konfiguracija (ne čuvati stvarni .env u Git-u)
BRIGA_DEBUG=0
BRIGA_SECRET_KEY=ovde-uneti-dugacak-nasumican-tajni-kljuc-od-najmanje-50-karaktera
BRIGA_ALLOWED_HOSTS=briga-plus.rs,www.briga-plus.rs
BRIGA_CSRF_TRUSTED_ORIGINS=https://briga-plus.rs,https://www.briga-plus.rs
DATABASE_URL=postgresql://korisnik:lozinka@host:5432/briga_plus
# Web-push: VAPID javni ključ može biti vidljiv pregledniku, privatni mora ostati samo na serveru.
BRIGA_VAPID_PUBLIC_KEY=ovde-uneti-application-server-key
BRIGA_VAPID_PRIVATE_KEY=ovde-uneti-ceo-privatni-pem-kljuc-sa-novim-redovima
BRIGA_VAPID_SUBJECT=mailto:podrska@briga-plus.rs
# Trajni privatni media bucket (R2, S3 ili drugi S3-kompatibilan servis)
BRIGA_STORAGE_BUCKET=briga-plus-private
BRIGA_STORAGE_ACCESS_KEY_ID=ovde-uneti-pristupni-kljuc
BRIGA_STORAGE_SECRET_ACCESS_KEY=ovde-uneti-tajni-pristupni-kljuc
BRIGA_STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
BRIGA_STORAGE_REGION=auto
